# ---------------------------------------------------------------------------
# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env.
# Deployed environments inject these from a managed secrets service.
# ---------------------------------------------------------------------------
APP_ENV=local
APP_SECRET_KEY=replace-with-64-random-chars-python-c-import-secrets-print-secrets-token-hex-32
# Fernet key for the encrypted credential store:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
AUTH_MODE=dev

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Primary database (PostgreSQL) and cache/queue (Redis)
DATABASE_URL=postgresql+psycopg://admin:admin123@postgres:5432/admin
REDIS_URL=redis://redis:6379/0

# Salesforce: "mock" runs the full flow against a built-in demo org.
# Switch to "live" after creating an External Client App (see docs/runbooks/salesforce-external-client-app.md)
SALESFORCE_MODE=mock
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=v62.0
SF_CALLBACK_URL=http://localhost:8000/api/v1/salesforce/oauth/callback
SF_SCOPES=api refresh_token openid

# Background jobs: "queue" (Redis + worker) or "inline" (tests)
SYNC_MODE=queue

# AI gateway: mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Governance
QUERY_DEFAULT_LIMIT=50
QUERY_MAX_LIMIT=200
POLICY_BLOCKED_OBJECTS=
POLICY_BLOCKED_FIELDS=
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=15

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER=console

# MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PUBLIC_URL=http://localhost:8001/mcp
